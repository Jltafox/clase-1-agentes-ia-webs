---
/**
 * Página pillar por servicio: /reparacion-aire-acondicionado/, /instalacion-aire-acondicionado/, etc.
 * getStaticPaths → genera 4 páginas pillar (una por servicio)
 */
import Layout from '../../layouts/Layout.astro';
import data from '../../data/areas-served.json';

export function getStaticPaths() {
  return data.servicios.map((s) => ({
    params: { servicio: s.slug },
    props: { servicio: s },
  }));
}

const { servicio } = Astro.props;
const { ciudades, negocio } = data;

const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Service',
      name: `${servicio.titulo} en el Vallès`,
      provider: {
        '@type': 'HVACBusiness',
        '@id': 'https://climatechvalles.com/#negocio',
        name: 'ClimaTech Vallès',
        url: 'https://climatechvalles.com',
      },
      areaServed: ciudades.map((c) => ({ '@type': 'City', name: c.nombre })),
      serviceType: servicio.titulo,
      description: servicio.descripcion_corta,
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Inicio', item: 'https://climatechvalles.com/' },
        { '@type': 'ListItem', position: 2, name: servicio.titulo, item: `https://climatechvalles.com/${servicio.slug}/` },
      ],
    },
  ],
};
---

<Layout
  title={`${servicio.titulo} en el Vallès | ClimaTech Vallès`}
  description={`${servicio.descripcion_corta} Sabadell, Terrassa, Rubí, Cerdanyola, Sant Cugat. Presupuesto sin compromiso.`}
  canonical={`https://climatechvalles.com/${servicio.slug}/`}
  schema={schema}
  telefono={negocio.telefono_general}
>

  <!-- ═══ HERO ═══ -->
  <section style="background: linear-gradient(135deg, #0066CC 0%, #004A99 100%); color:white;" class="py-14 md:py-20">
    <div class="max-w-4xl mx-auto px-4">
      <nav class="text-sm mb-5" style="color:#93C5FD;" aria-label="Breadcrumb">
        <a href="/" class="hover:text-white">Inicio</a>
        <span class="mx-2">›</span>
        <span style="color:white;">{servicio.titulo}</span>
      </nav>
      <h1 class="text-3xl md:text-4xl font-bold mb-4">{servicio.titulo} en el Vallès</h1>
      <p class="text-lg md:text-xl mb-8" style="color:#BFDBFE;">{servicio.descripcion_corta}</p>
      <a
        href={`tel:${negocio.telefono_general.replace(/\s/g, '')}`}
        class="inline-flex items-center gap-2 font-bold px-8 py-4 rounded-xl text-lg text-white transition-colors"
        style="background-color:#FF6B00;"
      >
        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 7V5z" />
        </svg>
        Llamar: {negocio.telefono_general}
      </a>
    </div>
  </section>

  <!-- ═══ CIUDADES CUBIERTAS ═══ -->
  <section class="py-16 bg-white">
    <div class="max-w-6xl mx-auto px-4">
      <h2 class="text-2xl font-bold mb-2">¿En qué ciudades ofrecemos {servicio.titulo_lower}?</h2>
      <p class="text-gray-500 mb-8">
        Selecciona tu ciudad para ver disponibilidad, precios orientativos y teléfono local.
      </p>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5">
        {ciudades.map((c) => (
          <a
            href={`/${servicio.slug}/${c.slug}/`}
            class="rounded-2xl p-6 shadow-sm border border-gray-100 hover:border-blue-300 hover:shadow-lg transition-all bg-white"
          >
            <div class="flex items-start justify-between mb-3">
              <h3 class="font-bold text-lg">{c.nombre}</h3>
              <span class="text-xs font-semibold px-2 py-1 rounded-full" style="background-color:#DCFCE7; color:#166534;">
                Disponible
              </span>
            </div>
            <p class="text-gray-500 text-sm mb-3">{c.descripcion.slice(0, 90)}…</p>
            <p class="font-semibold text-sm" style="color:#0066CC;">{c.telefono}</p>
            <p class="text-xs text-gray-400 mt-2">
              {servicio.titulo} en {c.nombre} →
            </p>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- ═══ QUÉ INCLUYE ═══ -->
  <section class="py-14" style="background-color:#F9FAFB;">
    <div class="max-w-4xl mx-auto px-4">
      <h2 class="text-2xl font-bold mb-8">¿Qué incluye nuestro servicio de {servicio.titulo_lower}?</h2>
      <ul class="grid grid-cols-1 sm:grid-cols-2 gap-3">
        {servicio.incluye.map((item) => (
          <li class="flex items-start gap-3 bg-white rounded-lg p-4 shadow-sm border border-gray-100">
            <span class="font-bold flex-shrink-0 mt-0.5" style="color:#16A34A;">✓</span>
            <span class="text-gray-700 text-sm">{item}</span>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- ═══ MARCAS ═══ -->
  <section class="py-12 bg-white">
    <div class="max-w-4xl mx-auto px-4">
      <h2 class="text-xl font-bold mb-6 text-center">Marcas con las que trabajamos</h2>
      <div class="flex flex-wrap justify-center gap-3">
        {servicio.marcas.map((marca) => (
          <span class="bg-gray-100 text-gray-700 font-medium px-4 py-2 rounded-full text-sm">{marca}</span>
        ))}
      </div>
    </div>
  </section>

  <!-- ═══ TABLA DE PRECIOS ═══ -->
  <section class="py-14" style="background-color:#F9FAFB;">
    <div class="max-w-4xl mx-auto px-4">
      <h2 class="text-2xl font-bold mb-2">Precios orientativos de {servicio.titulo_lower}</h2>
      <p class="text-gray-500 mb-6 text-sm">El precio final se confirma siempre tras el diagnóstico gratuito.</p>
      <div class="bg-white rounded-2xl shadow-sm overflow-hidden border border-gray-100">
        <table class="w-full text-sm">
          <thead style="background-color:#0066CC; color:white;">
            <tr>
              <th class="text-left px-5 py-3 font-semibold">Servicio</th>
              <th class="text-left px-5 py-3 font-semibold">Desde</th>
              <th class="text-left px-5 py-3 font-semibold">Hasta</th>
              <th class="text-left px-5 py-3 font-semibold hidden sm:table-cell">Nota</th>
            </tr>
          </thead>
          <tbody>
            {servicio.precios.map((precio, i) => (
              <tr style={i % 2 === 0 ? 'background-color:white;' : 'background-color:#F9FAFB;'}>
                <td class="px-5 py-3 font-medium">{precio.servicio}</td>
                <td class="px-5 py-3 font-semibold" style="color:#0066CC;">{precio.min}</td>
                <td class="px-5 py-3">{precio.max}</td>
                <td class="px-5 py-3 text-gray-400 hidden sm:table-cell">{precio.nota}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <div class="mt-6">
        <a href="/contacto/" class="inline-block text-white font-semibold px-6 py-3 rounded-xl transition-colors"
           style="background-color:#0066CC;">
          Pide presupuesto sin compromiso
        </a>
      </div>
    </div>
  </section>

</Layout>
