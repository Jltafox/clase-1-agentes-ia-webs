---
interface Props {
  title: string;
  description: string;
  canonical: string;
  schema?: unknown;
  telefono?: string;
  ciudad?: string;
}

const {
  title,
  description,
  canonical,
  schema,
  telefono = '936 XX XX XX',
  ciudad,
} = Astro.props;

const schemaStr = schema ? JSON.stringify(schema) : null;
const telHref = `tel:${telefono.replace(/\s/g, '')}`;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="es" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <!-- Google Fonts — carga NO bloqueante (crítico para FCP/LCP) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="preload"
      as="style"
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap"
      onload="this.onload=null;this.rel='stylesheet'"
    />
    <noscript>
      <link
        href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap"
        rel="stylesheet"
      />
    </noscript>

    <!-- Schema JSON-LD -->
    {schemaStr && <script type="application/ld+json" set:html={schemaStr} />}
  </head>

  <body class="bg-white text-gray-900" style="font-family: Inter, system-ui, sans-serif;">

    <!-- ─── Sticky phone bar (mobile) ─── -->
    <div class="fixed bottom-0 left-0 right-0 z-50 md:hidden bg-blue-700 shadow-2xl">
      <a
        href={telHref}
        class="flex items-center justify-center gap-3 py-4 text-white font-bold text-lg"
      >
        <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
            d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 7V5z" />
        </svg>
        Llamar ahora · {telefono}
      </a>
    </div>

    <!-- ─── Header ─── -->
    <header class="bg-white border-b border-gray-200 sticky top-0 z-40">
      <div class="max-w-6xl mx-auto px-4 py-3 flex items-center justify-between">
        <a href="/" class="flex items-center gap-1">
          <span class="text-2xl font-bold" style="color:#0066CC">ClimaTech</span>
          <span class="text-gray-500 font-medium hidden sm:inline ml-1">Vallès</span>
        </a>

        <nav class="hidden md:flex items-center gap-5 text-sm font-medium text-gray-700">
          <a href="/reparacion-aire-acondicionado/" class="hover:text-blue-700 transition-colors">Reparación AC</a>
          <a href="/instalacion-aire-acondicionado/" class="hover:text-blue-700 transition-colors">Instalación</a>
          <a href="/mantenimiento-aire-acondicionado/" class="hover:text-blue-700 transition-colors">Mantenimiento</a>
          <a href="/reparacion-caldera/" class="hover:text-blue-700 transition-colors">Calderas</a>
        </nav>

        <a
          href={telHref}
          class="hidden md:flex items-center gap-2 text-white font-semibold px-4 py-2 rounded-lg text-sm transition-colors"
          style="background-color:#0066CC"
          onmouseover="this.style.backgroundColor='#004A99'"
          onmouseout="this.style.backgroundColor='#0066CC'"
        >
          <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
              d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 7V5z" />
          </svg>
          {telefono}
        </a>
      </div>
    </header>

    <!-- ─── Main content ─── -->
    <main class="pb-20 md:pb-0">
      <slot />
    </main>

    <!-- ─── Footer ─── -->
    <footer style="background-color:#111827; color:#D1D5DB;" class="py-12 mt-0">
      <div class="max-w-6xl mx-auto px-4 grid grid-cols-1 md:grid-cols-3 gap-8">

        <div>
          <h3 class="text-white font-bold text-lg mb-3">ClimaTech Vallès</h3>
          <p class="text-sm leading-relaxed">
            Servicio técnico de aire acondicionado y calderas en el Vallès Occidental.
            Técnicos certificados. Garantía en todas las reparaciones.
          </p>
        </div>

        <div>
          <h3 class="text-white font-bold text-lg mb-3">Servicios</h3>
          <ul class="space-y-2 text-sm">
            <li><a href="/reparacion-aire-acondicionado/" class="hover:text-white transition-colors">Reparación de Aire Acondicionado</a></li>
            <li><a href="/instalacion-aire-acondicionado/" class="hover:text-white transition-colors">Instalación de Aire Acondicionado</a></li>
            <li><a href="/mantenimiento-aire-acondicionado/" class="hover:text-white transition-colors">Mantenimiento de Aire Acondicionado</a></li>
            <li><a href="/reparacion-caldera/" class="hover:text-white transition-colors">Reparación de Calderas</a></li>
          </ul>
        </div>

        <div>
          <h3 class="text-white font-bold text-lg mb-3">Zonas cubiertas</h3>
          <ul class="space-y-2 text-sm">
            <li><a href="/reparacion-aire-acondicionado/sabadell/" class="hover:text-white transition-colors">Reparación AC en Sabadell</a></li>
            <li><a href="/reparacion-aire-acondicionado/terrassa/" class="hover:text-white transition-colors">Reparación AC en Terrassa</a></li>
            <li><a href="/reparacion-aire-acondicionado/rubi/" class="hover:text-white transition-colors">Reparación AC en Rubí</a></li>
            <li><a href="/reparacion-aire-acondicionado/cerdanyola-del-valles/" class="hover:text-white transition-colors">Reparación AC en Cerdanyola</a></li>
            <li><a href="/reparacion-aire-acondicionado/sant-cugat-del-valles/" class="hover:text-white transition-colors">Reparación AC en Sant Cugat</a></li>
          </ul>
        </div>

      </div>

      <div class="max-w-6xl mx-auto px-4 mt-8 pt-6 border-t border-gray-700 text-xs text-gray-500 flex flex-col md:flex-row justify-between gap-3">
        <p>© 2026 ClimaTech Vallès · Todos los derechos reservados</p>
        <nav class="flex gap-4">
          <a href="/aviso-legal/" class="hover:text-gray-300">Aviso legal</a>
          <a href="/politica-privacidad/" class="hover:text-gray-300">Privacidad</a>
          <a href="/cookies/" class="hover:text-gray-300">Cookies</a>
          <a href="/sobre-nosotros/" class="hover:text-gray-300">Quiénes somos</a>
        </nav>
      </div>
    </footer>

  </body>
</html>
