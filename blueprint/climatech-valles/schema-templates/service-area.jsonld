{
  "@context": "https://schema.org",
  "@graph": [

    {
      "@type": "HVACBusiness",
      "@id": "https://climatechvalles.com/#negocio",
      "name": "ClimaTech Vallès",
      "telephone": "{{telefono_ciudad}}",
      "url": "https://climatechvalles.com",
      "logo": "https://climatechvalles.com/logo.png",
      "image": "https://climatechvalles.com/images/{{ciudad-slug}}-taller.jpg",
      "description": "Servicio técnico de aire acondicionado y calderas en {{ciudad}} y alrededores.",
      "address": {
        "@type": "PostalAddress",
        "streetAddress": "{{direccion}}",
        "addressLocality": "{{ciudad}}",
        "postalCode": "{{cp}}",
        "addressCountry": "ES"
      },
      "geo": {
        "@type": "GeoCoordinates",
        "latitude": "{{lat}}",
        "longitude": "{{lng}}"
      },
      "areaServed": {
        "@type": "City",
        "name": "{{ciudad}}"
      },
      "openingHoursSpecification": [
        {
          "@type": "OpeningHoursSpecification",
          "dayOfWeek": ["Monday","Tuesday","Wednesday","Thursday","Friday"],
          "opens": "08:00",
          "closes": "20:00"
        },
        {
          "@type": "OpeningHoursSpecification",
          "dayOfWeek": ["Saturday"],
          "opens": "09:00",
          "closes": "17:00"
        }
      ],
      "priceRange": "€€",
      "currenciesAccepted": "EUR",
      "paymentAccepted": "Cash, Credit Card"
    },

    {
      "@type": "Service",
      "name": "{{servicio_titulo}} en {{ciudad}}",
      "provider": { "@id": "https://climatechvalles.com/#negocio" },
      "areaServed": {
        "@type": "PostalAddress",
        "addressLocality": "{{ciudad}}",
        "postalCode": "{{cp}}",
        "addressCountry": "ES"
      },
      "serviceType": "{{servicio_titulo}}",
      "description": "{{servicio_titulo}} profesional en {{ciudad}}. Presupuesto sin compromiso."
    },

    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        {
          "@type": "ListItem",
          "position": 1,
          "name": "Inicio",
          "item": "https://climatechvalles.com/"
        },
        {
          "@type": "ListItem",
          "position": 2,
          "name": "{{servicio_titulo}}",
          "item": "https://climatechvalles.com/{{servicio-slug}}/"
        },
        {
          "@type": "ListItem",
          "position": 3,
          "name": "{{ciudad}}",
          "item": "https://climatechvalles.com/{{servicio-slug}}/{{ciudad-slug}}/"
        }
      ]
    },

    {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "¿En cuánto tiempo llega el técnico a {{ciudad}}?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Nuestros técnicos en {{ciudad}} suelen llegar en menos de 2 horas. Llamando al {{telefono_ciudad}} gestionamos la visita para el mismo día."
          }
        },
        {
          "@type": "Question",
          "name": "¿Cuánto cuesta reparar el aire acondicionado en {{ciudad}}?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "El diagnóstico en {{ciudad}} es gratuito con reparación. El precio depende de la avería; las más comunes (carga de gas, limpieza, sensor) oscilan entre 60 y 150 €."
          }
        },
        {
          "@type": "Question",
          "name": "¿Qué marcas reparáis en {{ciudad}}?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Reparamos todas las marcas en {{ciudad}}: Daikin, Mitsubishi, Samsung, LG, Fujitsu, Panasonic, Carrier, Hitachi y muchas más."
          }
        },
        {
          "@type": "Question",
          "name": "¿Ofrecéis garantía en las reparaciones en {{ciudad}}?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Sí, todas las reparaciones realizadas en {{ciudad}} incluyen garantía. Las piezas tienen garantía de fábrica y la mano de obra está garantizada 3 meses."
          }
        },
        {
          "@type": "Question",
          "name": "¿Trabajáis en fines de semana en {{ciudad}}?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Sí, atendemos en {{ciudad}} de lunes a sábado. Sábados de 9:00 a 17:00. Llama al {{telefono_ciudad}} para urgencias."
          }
        }
      ]
    }

  ]
}
